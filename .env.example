# === Banco de dados ===
DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/database

# === JWT / Auth ===
SECRET_KEY=troque_esta_chave_por_uma_secreta
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# === Refresh Cookie ===
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# === Albion API ===
ALBION_REGION=europe
ALBION_API_TIMEOUT=15

# === CORS / Frontend ===
FRONTEND_URL=http://localhost:5173

# === Alert checker ===
CRON_SECRET=troque_por_um_segredo

# === E-mail (Resend preferencial em produção) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# === SMTP (uso local opcional) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
